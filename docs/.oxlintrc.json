{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc",
    "nextjs"
  ],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2020": true
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [".next", "out", "build", "next-env.d.ts", ".source"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-sync-scripts": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-array-delete": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/no-duplicate-type-constituents": "warn",
    "typescript/no-for-in-array": "warn",
    "typescript/no-implied-eval": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-enum-comparison": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/no-unsafe-unary-minus": "warn",
    "typescript/only-throw-error": "warn",
    "typescript/prefer-promise-reject-errors": "warn",
    "typescript/require-await": "warn",
    "typescript/restrict-plus-operands": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/unbound-method": "warn"
  }
}
